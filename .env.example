# Optional. The app works without these keys using OpenStreetMap/Nominatim and local AI fallbacks.
PORT=8290
DATA_DIR=./data

# Server-side AI. Never expose this in VITE_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional server-side Google Places discovery/search.
GOOGLE_MAPS_API_KEY=

# Optional browser Google Maps JS integration can be added later.
# The default map is MapLibre + OpenStreetMap, requiring no key.
